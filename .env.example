# Configuration PanierMalin
# Copiez ce fichier en ".env" et adaptez les valeurs si besoin.

# Port du serveur local de prévisualisation (npm start)
APP_PORT=5500

# Environnement d'exécution (development | production)
APP_ENV=development

# Indicatif téléphonique par défaut
DEFAULT_COUNTRY_CODE=+225

# URL des tuiles cartographiques OpenStreetMap
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Clés agrégateur Mobile Money GeniusPay (https://pay.genius.ci)
# À ajouter dans Vercel > Project Settings > Environment Variables
GENIUSPAY_API_KEY=pk_test_votre_cle_publique
GENIUSPAY_API_SECRET=sk_test_votre_cle_secrete
GENIUSPAY_WEBHOOK_SECRET=whsec_votre_secret_webhook
